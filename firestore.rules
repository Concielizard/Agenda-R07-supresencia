rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidId(userId)
        && incoming().userId == userId
        && incoming().displayName is string
        && incoming().displayName.size() <= 120;
      allow update: if isOwner(userId)
        && incoming().userId == userId
        && incoming().displayName is string
        && incoming().displayName.size() <= 120;
      allow delete: if isOwner(userId);

      // User's Weekly Devotional Records
      match /weeks/{weekId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(weekId)
          && incoming().userId == userId
          && incoming().startDate is string
          && incoming().startDate.size() <= 30;
        allow update: if isOwner(userId)
          && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }
    }

    // Community Prayer Requests
    match /prayer_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId);
      allow list: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(requestId)
        && incoming().userId == request.auth.uid
        && incoming().userName is string
        && incoming().userName.size() <= 120
        && incoming().title is string
        && incoming().title.size() <= 200
        && incoming().content is string
        && incoming().content.size() <= 2000;
      allow update: if isSignedIn()
        && isValidId(requestId)
        && (
          // Owner full update
          (existing().userId == request.auth.uid && incoming().userId == request.auth.uid) ||
          // Community member praying (increment prayer count only)
          (incoming().diff(existing()).affectedKeys().hasOnly(['prayerCount', 'updatedAt']) && incoming().prayerCount is number)
        );
      allow delete: if isSignedIn() && isValidId(requestId) && existing().userId == request.auth.uid;
    }
  }
}
